<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_root_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4D000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Floating Dialog Card (Auto-aligns above the software keyboard) -->
    <LinearLayout
        android:id="@+id/ll_prompt_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/widget_pill_background"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">

        <!-- ChatGPT Icon -->
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_chatgpt"
            android:contentDescription="ChatGPT"
            android:padding="2dp" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/et_quick_prompt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:background="@null"
            android:hint="Ask ChatGPT anything..."
            android:textColor="@color/widget_text_primary"
            android:textColorHint="@color/widget_text_hint"
            android:textSize="16sp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btn_send_prompt"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_circle_button"
            android:src="@drawable/ic_send"
            android:contentDescription="Send to ChatGPT"
            android:padding="9dp"
            android:scaleType="fitCenter" />

    </LinearLayout>

</FrameLayout>


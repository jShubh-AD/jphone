<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_pill_background"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- ChatGPT Logo -->
    <ImageView
        android:id="@+id/iv_chatgpt_logo"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_chatgpt"
        android:contentDescription="ChatGPT"
        android:padding="3dp" />

    <!-- Chat Prompt Bar (Tappable Area for Option B) -->
    <LinearLayout
        android:id="@+id/btn_chat_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_search_pill"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tv_prompt_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask ChatGPT..."
            android:textColor="@color/widget_text_hint"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Quick Action 1: Live Voice / Headphones -->
    <ImageButton
        android:id="@+id/btn_voice_mode"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_circle_button"
        android:src="@drawable/ic_headphones"
        android:contentDescription="Voice Mode"
        android:padding="9dp"
        android:scaleType="fitCenter" />

    <!-- Quick Action 2: Microphone -->
    <ImageButton
        android:id="@+id/btn_mic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_circle_button"
        android:src="@drawable/ic_mic"
        android:contentDescription="Microphone"
        android:padding="9dp"
        android:scaleType="fitCenter" />

    <!-- Quick Action 3: History -->
    <ImageButton
        android:id="@+id/btn_history"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_circle_button"
        android:src="@drawable/ic_history"
        android:contentDescription="Chat History"
        android:padding="9dp"
        android:scaleType="fitCenter" />

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Floating History Sheet / Card -->
    <LinearLayout
        android:id="@+id/ll_history_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:maxHeight="480dp"
        android:background="@drawable/widget_pill_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="14dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_history"
                    android:contentDescription="History" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Recent Prompts"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_open_chatgpt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Open App ↗"
                android:textColor="@color/widget_text_hint"
                android:textSize="13sp"
                android:textStyle="bold"
                android:padding="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_border"
            android:layout_marginBottom="8dp" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tv_empty_history"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="No recent prompts yet.\nTap 'Ask ChatGPT' on the widget to start!"
            android:textColor="@color/widget_text_hint"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- History Items List -->
        <ListView
            android:id="@+id/lv_history_prompts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/widget_border"
            android:dividerHeight="0.5dp"
            android:scrollbars="vertical" />

    </LinearLayout>

</FrameLayout>

